---
import Section from "../components/common/Section.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Section class="mt-16">
    <h1 class="text-3xl sm:text-4xl font-display pb-8">
      Страница не найдена
    </h1>
    <h2 class="text-xl sm:text-2xl pb-8">Ошибка 404</h2>
    <p>
      Такой страницы нет. Можно <a
        class="underline underline-offset-4 font-medium"
        href="/">вернуться на главную</a
      >.
    </p>
  </Section>
</Layout>
