---
import Section from "../components/common/Section.astro";
import type { ArticleFrontmatter } from "../lib/types";
import {
  getShortDescription,
  processArticleDate,
  generateSourceUrl,
} from "../lib/utils";
import { GLOBAL } from "../lib/variables";
import type { MarkdownLayoutProps } from "astro";
import Prose from "../components/Prose.astro";
import NotesNavigation from "../components/notes/NotesNavigation.astro";
import Layout from "./Layout.astro";

type Props = MarkdownLayoutProps<ArticleFrontmatter & { compact?: boolean }>;

const { frontmatter } = Astro.props;
const shortDescription = getShortDescription(frontmatter.description);
const articleDate = processArticleDate(frontmatter.timestamp);
const isNote = Astro.url.pathname.startsWith("/notes/");
const sourceUrl = isNote
  ? `${GLOBAL.rootUrl}/notes/${frontmatter.filename}`
  : generateSourceUrl(frontmatter.filename, "blog");
---

<Layout>
  <Fragment slot="head">
    <title>{frontmatter.title} • {GLOBAL.username}</title>
    {isNote && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={frontmatter.description} />
    <meta property="og:title" content={`${frontmatter.title} • ${GLOBAL.username}`} />
    <meta property="og:description" content={shortDescription} />
    <meta property="og:image" content={`${GLOBAL.rootUrl}/${GLOBAL.profileImage}`} />
    <meta property="og:url" content={frontmatter.url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${frontmatter.title} • ${GLOBAL.username}`} />
    <meta name="twitter:description" content={shortDescription} />
    <meta name="twitter:image" content={`${GLOBAL.rootUrl}/${GLOBAL.profileImage}`} />
    <meta http-equiv="content-language" content="en" />
    <meta name="language" content="English" />
    <link rel="canonical" href={sourceUrl} />
  </Fragment>
  <Section class="pt-8">
    {isNote && <div class="mb-4"><NotesNavigation /></div>}
    <div class:list={["flex flex-col gap-4 mb-4", frontmatter.compact ? "mt-0" : "mt-8"]}>
      <h1
        class:list={[frontmatter.compact ? "text-xl sm:text-2xl font-mono" : "text-3xl sm:text-4xl leading-normal sm:leading-normal font-display"]}
      >
        {frontmatter.title}
      </h1>
      {!frontmatter.compact && <div class="flex justify-between">
        <span>{articleDate}</span>
        <span>{frontmatter.time} мин</span>
      </div>}
    </div>
    <Prose>
      <slot />
    </Prose>
    {isNote && <div class="mt-8"><NotesNavigation /></div>}
    <!-- <p class="pt-8">~{GLOBAL.username}</p> -->
  </Section>
</Layout>
