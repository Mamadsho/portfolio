---
import { GLOBAL } from "../../lib/variables";
import ModelViewer from "../ModelViewer.astro";
---

<div class="flex flex-col items-center sm:flex-row gap-8">
  <!-- <ModelViewer
    classes="bg-black rounded-full max-w-40 w-40 h-40 mb-4 z-0 grayscale"
    src="/me.glb"
    positions={[[2.06247, -0.516702, 0.692462], [2.2, 0, 0],]}/> -->
  <button
    type="button"
    id="notes-shortcut"
    aria-label="Личные заметки: нажмите три раза подряд"
    class="rounded-full shrink-0 mb-4 focus-visible:outline-2 focus-visible:outline-offset-4"
  >
  <img
    src={GLOBAL.profileImage}
    alt={GLOBAL.username}
    class="rounded-full max-w-40 w-40 h-40 z-0"
    draggable="false"
    style="filter:saturate(0.8)"
  />
  </button>
  <div>
    <h1
      class="text-3xl sm:text-4xl font-display font-semibold opsz text-center sm:text-left"
    >
      {GLOBAL.username}
    </h1>
    <h2
      class="text-center text-xl sm:text-2xl font-mono font-medium sm:text-left"
    >
      <p set:html={GLOBAL.selfDescription}/>
    </h2>
  </div>
</div>

<script>
  const shortcut = document.getElementById("notes-shortcut");
  let presses = 0;
  let lastPress = 0;

  shortcut?.addEventListener("click", () => {
    const now = performance.now();
    presses = now - lastPress <= 700 ? presses + 1 : 1;
    lastPress = now;
    if (presses === 3) {
      presses = 0;
      window.location.assign("/notes/");
    }
  });
</script>

<style>
  #notes-shortcut { touch-action: manipulation; }
</style>
