---
// Ряд схем с подписями. Схемы — белая графика на прозрачном фоне,
// поэтому в светлой теме инвертируются (как invertLight у ImageBox).
type Item = { src: string; caption?: string; alt?: string };
type Props = { images?: Item[]; invert?: boolean; cols?: number };

const { images = [], invert = true, cols = 3 } = Astro.props as Props;

// Классы перечислены целиком: Tailwind сканирует исходники как текст
// и склеенное имя вида `sm:grid-cols-${cols}` не сгенерирует.
const columns: Record<number, string> = {
  // 1: "sm:grid-cols-1",
  // 2: "sm:grid-cols-2",
  // 3: "sm:grid-cols-3",
  // 4: "sm:grid-cols-4",
  // 5: "sm:grid-cols-5",
  // 6: "sm:grid-cols-6",
  1: "grid-cols-1",
  2: "grid-cols-2",
  3: "grid-cols-3",
  4: "grid-cols-4",
  5: "grid-cols-5",
  6: "grid-cols-6",
};
---

<div class={`not-prose my-8 grid gap-6 grid-cols-1 ${columns[cols] ?? columns[3]}`}>
  {
    images.map((image: Item) => (
      <figure class="m-0">
        <img
          src={image.src}
          alt={image.alt ?? image.caption ?? ""}
          class={`w-full ${invert ? "invert-light" : ""}`}
        />
        <figcaption class="mt-2 text-xs zag-text-muted">{image.caption}</figcaption>
      </figure>
    ))
  }
</div>
