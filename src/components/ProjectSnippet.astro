---
import Anchor from "./common/Anchor.astro";
import Tags from "./common/Tags.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  githubUrl?: string;
  liveUrl?: string;
  tags: string[];
  banner: string;
};

const { title, description, url, githubUrl, liveUrl, tags, banner } =
  Astro.props;
---

<style>
  .banner {
    position: relative;
    height: 300px;
    background-position: center;
    background-size: cover;
    margin-bottom: 0px;
  }
  .info{
    background-color: #7d7d7d;
    padding: 10px;
    position: relative;
  }
  .snippet{
    margin-bottom: 10px;
  }
</style>

<div class="snippet">
<div
  class="flex flex-col gap-3 pb-8 banner"
  style=`background-image: url(${banner})`
>
</div>

<div class="info">
  <!-- <div class="flex flex-col gap-3 sm:flex-row sm:justify-between mb-2" style="color: var(--color-zag-light)"> -->
  <div class="flex flex-col gap-3 flex-row sm:justify-between mb-2" style="color: var(--color-zag-light)">
    <Anchor url={url} class="text-xl">
      {title}
    </Anchor>
    <div class="flex gap-2">
      {
        githubUrl ? (
          <Anchor url={githubUrl} class="text-base" external>
            GitHub
          </Anchor>
        ) : null
      }
      {
        liveUrl ? (
          <Anchor url={liveUrl} class="text-base" external>
            Live
          </Anchor>
        ) : null
      }
    </div>
  </div>
  <!--
  <p class="zag-text zag-transition" style="color: var(--color-zag-light)"> 
    {description}
  </p>
  -->
  <Tags tags={tags} />
</div>
</div>
