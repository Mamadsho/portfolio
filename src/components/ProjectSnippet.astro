---
import Anchor from "./common/Anchor.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  githubUrl?: string;
  liveUrl?: string;
  tags: string[];
  banner: string;
};

const { title, description, url, githubUrl, liveUrl, tags, banner } =
  Astro.props;
---

<style>
  .banner {
    position: relative;
    height: 300px;
    background-position: center;
    background-size: cover;
    margin-bottom: 10px;
  }
  .banner::before {
    content: "";
    backdrop-filter: brightness(0.5);
    height: 100%;
    width: 100%;
    position: absolute;
  }
  .info{
    padding: 10px;
    position:absolute;
    bottom:0;
  }
</style>

<div
  class="flex flex-col gap-3 pb-8 banner"
  style=`background-image: url(${banner})`
>
  <div class="info">
    <div class="flex flex-col gap-3 sm:flex-row sm:justify-between" style="color: var(--color-zag-light)">
      <Anchor url={url} class="text-xl">
        {title}
      </Anchor>
      <div class="flex gap-2">
        {
          githubUrl ? (
            <Anchor url={githubUrl} class="text-base" external>
              GitHub
            </Anchor>
          ) : null
        }
        {
          liveUrl ? (
            <Anchor url={liveUrl} class="text-base" external>
              Live
            </Anchor>
          ) : null
        }
      </div>
    </div>
    <p class="zag-text zag-transition" style="color: var(--color-zag-light)"> 
      {description}
    </p>
    <div class="flex flex-row flex-wrap gap-2">
      {
        tags.map((tag) => (
          <span class="-zag-text -zag-bg zag-transition px-2 py-1 text-sm font-semibold">
            {tag}
          </span>
        ))
      }
    </div>
  </div>
</div>
