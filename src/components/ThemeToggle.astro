<button class="border-none bg-none focus:outline-2 focus:outline-offset-2 focus:outline-zag-dark dark:focus:outline-zag-light" id="themeToggle" aria-label="Переключить тему">
  <svg
    width="30px"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    name="Theme toggle"
  >
    <path
      class="zag-transition fill-neutral-900 dark:fill-transparent"
      fill-rule="evenodd"
      d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"
    ></path>
    <path
      class="zag-transition fill-transparent night:fill-neutral-100"
      fill-rule="evenodd"
      d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"
    ></path>
    <!--
      Pitch black: пустая луна — светится только контур, как от света сзади.
      Геометрия подобрана под итоговые 30px (viewBox 24 → масштаб 1.25):
      центр 12 → 15px, внешний радиус 9.6 → 12px, внутренний 8 → 10px,
      толщина 1.6 → ровно 2px (как --zag-stroke). Края кольца ложатся на
      целые пиксели — 3, 5, 25 и 27 — поэтому контур не размывается.
    -->
    <path
      class="zag-transition fill-transparent black:fill-neutral-100"
      fill-rule="evenodd"
      d="M12 2.4a9.6 9.6 0 1 0 0 19.2 9.6 9.6 0 1 0 0-19.2zm0 1.6a8 8 0 1 0 0 16 8 8 0 1 0 0-16z"
    ></path>
  </svg>
</button>

<script is:inline>
  // Саму тему применяет скрипт в <head> (см. Layout.astro) — до первой
  // отрисовки. Здесь только переключение по кругу и подпись для читалок.
  const themeLabels = {
    light: "Тема: светлая",
    dark: "Тема: тёмная",
    black: "Тема: чёрная",
  };

  const themeButton = document.getElementById("themeToggle");

  const setThemeLabel = (theme) =>
    themeButton?.setAttribute("aria-label", themeLabels[theme] ?? "Переключить тему");

  setThemeLabel(localStorage.getItem("theme") ?? "light");

  themeButton?.addEventListener("click", () => {
    const themes = window.zagThemes ?? ["light", "dark"];
    const current = localStorage.getItem("theme") ?? "light";
    const next = themes[(themes.indexOf(current) + 1) % themes.length];

    window.zagApplyTheme?.(next);
    setThemeLabel(next);
  });
</script>
